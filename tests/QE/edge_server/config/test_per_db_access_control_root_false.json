{
    "$schema": "https://packages.couchbase.com/couchbase-edge-server/config_schema.json",
    "interface": "0.0.0.0:59840",
    "enable_user_access_control": false,
    "enable_anonymous_users": true,
    "users": "/home/ec2-user/user/per_db_access_users.json",
    "databases": {
        "enforced": {
            "path": "/home/ec2-user/database/enforced.cblite2",
            "create": true,
            "enable_client_writes": true,
            "enable_client_sync": true,
            "enable_user_access_control": true
        },
        "exempt": {
            "path": "/home/ec2-user/database/exempt.cblite2",
            "create": true,
            "enable_client_writes": true,
            "enable_client_sync": true,
            "enable_user_access_control": false
        },
        "inherits": {
            "path": "/home/ec2-user/database/inherits.cblite2",
            "create": true,
            "enable_client_writes": true,
            "enable_client_sync": true
        }
    },
    "logging": {
        "console": true,
        "file": {
            "dir": "/home/ec2-user/log",
            "format": "text"
        },
        "domains": {
            "Listener": "info"
        }
    }
}
