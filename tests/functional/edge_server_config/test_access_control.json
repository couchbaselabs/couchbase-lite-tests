{
    "$schema": "https://packages.couchbase.com/couchbase-edge-server/config_schema.json",
    "interface": "0.0.0.0:59840",
    "enable_anonymous_users": false,
    "enable_user_access_control": true,
    "users": "/home/ec2-user/user/access_control_users.json",
    "cors": {
        "origin": [
            "http://localhost:5173"
        ],
        "headers": [
            "Authorization",
            "Content-Type",
            "If-Match"
        ],
        "max_age": 600
    },
    "databases": {
        "travel": {
            "path": "/home/ec2-user/database/travel.cblite2",
            "enable_client_writes": true,
            "enable_client_sync": true,
            "enable_adhoc_queries": true,
            "queries": {
                "airline_ids": {
                    "statement": "SELECT meta().id FROM travel.airlines LIMIT 5"
                },
                "hotel_ids": {
                    "statement": "SELECT meta().id FROM travel.hotels LIMIT 5",
                    "allow": {
                        "collections": [
                            "travel.hotels",
                            "travel.landmarks"
                        ]
                    }
                }
            }
        },
        "names": {
            "path": "/home/ec2-user/database/names.cblite2",
            "enable_client_writes": true,
            "enable_client_sync": true,
            "queries": {
                "name_ids": {
                    "statement": "SELECT meta().id FROM _default LIMIT 5"
                }
            }
        }
    },
    "logging": {
        "console": true,
        "file": {
            "dir": "/home/ec2-user/log",
            "format": "text"
        },
        "domains": {
            "Listener": "info"
        }
    }
}