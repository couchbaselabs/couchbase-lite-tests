// platform -> [ [version: "4.2.0", build: "9", dataset: "4.0"], ... ]  (one entry per train)
def resolved = [:]
// "<platform> <train>" strings that failed to resolve; marks the build UNSTABLE.
def failed = []

def ALL_PLATFORMS = ['c', 'android', 'java', 'ios', 'dotnet']

def progetProductFor(String platform) {
    return "couchbase-lite-" + ((platform == "dotnet") ? "net" : platform)
}

// A fully-qualified "<version>-<build>" param is used as-is; otherwise the latest
// build is looked up via ProGet get_version.
def resolveVersionBuild(proget, String product, String param, String label) {
    def version = proget.resolveProgetVersion(product, param, label)
    def buildNo
    if (version.contains('-')) {
        def parts = version.split('-', 2)
        version = parts[0]
        buildNo = parts[1]
    } else {
        def buildUrl = "http://proget.build.couchbase.com:8080/api/get_version?product=${product}&version=${version}"
        buildNo = sh(
            script: "curl -sf '${buildUrl}' | python3 -c 'import json,sys; print(json.load(sys.stdin).get(\"BuildNumber\",\"\"))'",
            returnStdout: true
        ).trim()
    }
    if (!buildNo) { error "Could not resolve build number for ${product} ${version}" }
    def major = version.tokenize('.')[0].toInteger()
    return [version: version, build: buildNo, dataset: (major >= 4) ? "4.0" : "3.2"]
}

// Fetch the list of currently-supported (non-EOL) trains for a product, e.g.
// get_trains?product=couchbase-lite-ios -> ["3.2","3.3","4.0","3.4","4.1","4.2"].
def fetchTrains(String product) {
    def url = "http://proget.build.couchbase.com:8080/api/get_trains?product=${product}"
    def raw = sh(
        script: "curl -sf '${url}' | python3 -c 'import json,sys; print(\"\\n\".join(json.load(sys.stdin)))'",
        returnStdout: true
    ).trim()
    return raw ? raw.tokenize() : []
}

pipeline {
    // Dedup state lives on this node's filesystem (~/.jenkins_build_info).
    agent { label 'qe-mac-india' }
    environment {
        PATH = "/opt/homebrew/opt/python@3.10/bin:/opt/homebrew/bin:/usr/local/bin:${env.PATH}"
    }
    parameters {
        choice(name: 'CBL_PLATFORM', choices: ['all', 'c', 'android', 'java', 'ios', 'dotnet'], description: 'CBL platform to run QE tests for')
        string(name: 'CBL_VERSION', defaultValue: '', description: "CBL version or train (e.g. 4.2.0 or 4.2). Leave blank to auto-resolve and test the latest build of EVERY non-EOL train from ProGet get_trains, per platform. The build number is resolved automatically.")
        string(name: 'SGW_VERSION', defaultValue: '4.0.0', description: 'The version of Sync Gateway to use')
        booleanParam(name: 'FORCE_TRIGGER', defaultValue: false, description: 'Force triggering the QE test job(s) even if this version+build already ran')
    }
    options {
        ansiColor('xterm')
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }
    triggers {
        cron('''TZ=Asia/Kolkata
0 4 * * *''')
    }
    stages {
        stage('Init') {
            steps {
                script {
                    if (params.SGW_VERSION == '') { error "SGW_VERSION is required" }
                    currentBuild.description = "SGW: ${params.SGW_VERSION}"
                }
            }
        }
        stage('Resolve Versions') {
            steps {
                script {
                    def platforms = (params.CBL_PLATFORM == 'all') ? ALL_PLATFORMS : [params.CBL_PLATFORM]
                    def proget = load 'jenkins/pipelines/shared/resolveProgetVersion.groovy'

                    for (p in platforms) {
                        def product = progetProductFor(p)

                        // A specific CBL_VERSION param targets one train/version; a blank
                        // param fans out over every non-EOL train from get_trains.
                        def trains
                        if (params.CBL_VERSION?.trim()) {
                            trains = [params.CBL_VERSION.trim()]
                        } else {
                            try {
                                trains = fetchTrains(product)
                            } catch (Exception e) {
                                echo "WARN: could not fetch trains for ${p} (${product}): ${e.getMessage()}"
                                failed << "${p} (get_trains)"
                                continue
                            }
                            if (!trains) {
                                echo "WARN: no trains returned for ${p} (${product})"
                                failed << "${p} (get_trains)"
                                continue
                            }
                        }

                        // Resolve the latest build of each train; one train's failure
                        // must not block the others (nor the other platforms).
                        def entries = []
                        for (train in trains) {
                            try {
                                def info = resolveVersionBuild(proget, product, train, "CBL_VERSION")
                                entries << info
                                echo "${p}: CBL ${info.version}-${info.build} (dataset ${info.dataset})"
                            } catch (Exception e) {
                                echo "WARN: could not resolve ${p} train ${train} (${product}): ${e.getMessage()}"
                                failed << "${p} ${train}"
                            }
                        }
                        if (entries) { resolved[p] = entries }
                    }

                    if (resolved.isEmpty()) { error "Could not resolve any platform version" }

                    if (failed) {
                        currentBuild.result = 'UNSTABLE'
                        echo "WARNING: ${failed.size()} train(s) failed to resolve: ${failed}"
                    }
                }
            }
        }
        stage('Trigger QE Tests') {
            steps {
                script {
                    def selected = (params.CBL_PLATFORM == 'all') ? ALL_PLATFORMS : [params.CBL_PLATFORM]
                    def force = params.FORCE_TRIGGER
                    def sgwVersion = params.SGW_VERSION

                    // platform -> list of "<version>-<build>" actually triggered this run.
                    def triggeredByPlatform = [:]

                    for (platform in selected) {
                        def entries = resolved[platform]
                        if (!entries) {
                            echo "SKIP: ${platform} (no version could be resolved)"
                            continue
                        }
                        def jobName = "qe-${platform}-pipeline"

                        // Dedup per build: state is a { "<version>": "<build>" } map,
                        // shared across all trains of this platform.
                        def buildInfoFile = "${env.HOME}/.jenkins_build_info/${env.JOB_NAME}/${platform}.json"
                        echo "Build Info File: ${buildInfoFile}"
                        def buildInfo = [:]
                        if (!force && fileExists(buildInfoFile)) {
                            try {
                                buildInfo = readJSON file: buildInfoFile, returnPojo: true
                            } catch (Exception e) {
                                echo "WARN : Error when reading ${platform}.json : ${e}"
                            }
                        }

                        def triggered = []
                        def skipped = []
                        for (info in entries) {
                            def fullVersion = "${info.version}-${info.build}"
                            if (!force && buildInfo[info.version] == info.build) {
                                echo "SKIP: ${platform} v${fullVersion} (already triggered)"
                                skipped << fullVersion
                                continue
                            }

                            echo "Triggering '${jobName}' for ${platform} v${fullVersion} (dataset ${info.dataset})"
                            build job: jobName, parameters: [
                                string(name: "CBL_VERSION", value: fullVersion),
                                string(name: "SGW_VERSION", value: sgwVersion),
                                string(name: "TS_DATASET_VERSION", value: info.dataset)
                            ], wait: false

                            buildInfo[info.version] = info.build
                            triggered << fullVersion
                        }

                        // Persist dedup state once, after all trains are processed.
                        if (triggered) {
                            try {
                                writeJSON file: buildInfoFile, json: buildInfo
                            } catch (Exception e) {
                                error "Cannot save ${platform}.json with error: ${e}"
                            }
                            triggeredByPlatform[platform] = triggered
                        }

                        echo "${platform} triggered: ${triggered}"
                        echo "${platform} skipped:   ${skipped}"
                    }

                    def title = triggeredByPlatform ?
                        triggeredByPlatform.collect { p, v -> "${p}: ${v.join(', ')}" }.join('  |  ') :
                        'none'
                    currentBuild.displayName = "QE ${params.CBL_PLATFORM}  |  ${title}  (#${currentBuild.number})"
                }
            }
        }
    }
}
