pipeline {
    agent none
    parameters {
        string(name: 'CBL_VERSION', defaultValue: '3.3.0', description: 'Couchbase Lite Version (build number will be fetched if not provided)')
        string(name: 'SGW_VERSION', defaultValue: '4', description: "The version of Sync Gateway to download")
        string(name: 'TS_DATASET_VERSION', defaultValue: '4.0', description: 'The version of the dataset to use on the test servers')
        string(name: 'TS_TEST_FILTER', defaultValue: '', description: 'An optional filter for running a subset of tests')
        booleanParam(name: 'RUN_PREBUILD', defaultValue: true, description: 'Prebuild test servers (only for the checked platforms). Uncheck to skip prebuild entirely and reuse existing artifacts.')
        booleanParam(name: 'RUN_WINDOWS', defaultValue: true, description: 'Run Windows tests')
        booleanParam(name: 'RUN_MACOS',   defaultValue: true, description: 'Run macOS tests')
        booleanParam(name: 'RUN_IOS',     defaultValue: true, description: 'Run iOS tests')
        booleanParam(name: 'RUN_ANDROID', defaultValue: true, description: 'Run Android tests')
    }
    options {
        ansiColor('xterm')
        timestamps()
        timeout(time: 150, unit: 'MINUTES')
    }
    stages {
        stage('Init') {
            agent any
            steps {
                script {
                    if (params.CBL_VERSION == '') { error "CBL_VERSION is required" }
                    if (params.SGW_VERSION == '') { error "SGW_VERSION is required" }
                    def compat = load 'jenkins/pipelines/shared/cblSgwCompatibility.groovy'
                    def reason = compat.incompatibility(params.CBL_VERSION, params.SGW_VERSION)
                    if (reason) { error reason }
                    currentBuild.displayName = "Dotnet CBL:${params.CBL_VERSION} (#${currentBuild.number})"
                    currentBuild.description = "SGW: ${params.SGW_VERSION}"
                }
            }
        }
        stage('Prebuild Servers') {
            when { beforeAgent true; expression { params.RUN_PREBUILD } }
            steps {
                script {
                    def platforms = []
                    if (params.RUN_WINDOWS) { platforms << 'dotnet_windows' }
                    if (params.RUN_IOS)     { platforms << 'dotnet_ios' }
                    if (params.RUN_ANDROID) { platforms << 'dotnet_android' }
                    if (params.RUN_MACOS)   { platforms << 'dotnet_macos' }
                    if (platforms.isEmpty()) {
                        echo "No platforms selected — nothing to prebuild"
                    } else {
                        def parallelBuilds = [:]
                        for(p in platforms) {
                            def platform = p
                            parallelBuilds[platform] = {
                                build job: 'prebuild-test-server',
                                parameters: [
                                    string(name: 'TS_PLATFORM', value: platform),
                                    string(name: 'CBL_VERSION', value: params.CBL_VERSION),
                                ],
                                wait: true,
                                propagate: true
                            }
                        }
                        parallel parallelBuilds
                    }
                }
            }
        }
        stage('Run Tests') {
            parallel {
                stage('Windows') {
                    when { beforeAgent true; expression { params.RUN_WINDOWS } }
                    agent { label 'mob-e2e-win-02' }
                    options {
                        lock('mob-e2e-win-02')
                    }
                    environment {
                        TS_ARTIFACTS_DIR = 'dotnet_windows'
                    }
                    steps {
                        echo "=== Run Dotnet Windows Tests"
                        timeout(time: 120, unit: 'MINUTES') {
                            powershell "jenkins\\pipelines\\QE\\dotnet\\run_test.ps1 -Version ${params.CBL_VERSION} -SgwVersion ${params.SGW_VERSION} -DatasetVersion ${params.TS_DATASET_VERSION} -TestFilter '${params.TS_TEST_FILTER}'"
                        }
                        echo "=== Dotnet Windows Tests Complete"
                    }
                    post {
                        always {
                            // Publish pytest's JUnit XML so per-test failures (messages and
                            // tracebacks) are surfaced in Jenkins even if teardown fails.
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true

                            echo "=== Teardown Dotnet Windows Tests"
                            timeout(time: 5, unit: 'MINUTES') {
                                powershell 'jenkins\\pipelines\\QE\\dotnet\\teardown.ps1'
                            }
                            archiveArtifacts artifacts: 'tests\\QE\\dotnet_windows\\**\\*', fingerprint: true, allowEmptyArchive: true
                            echo "=== Dotnet Windows Test Teardown Complete"
                        }
                    }
                }
                stage('macOS') {
                    when { beforeAgent true; expression { params.RUN_MACOS } }
                    agent { label 'e2e&&macos-host' }
                    environment {
                        KEYCHAIN_PASSWORD = credentials("${env.NODE_NAME}-keychain-password")
                        TS_ARTIFACTS_DIR = 'dotnet_macos'
                    }
                    steps {
                        // Unlock keychain: the Catalyst app is signed, and the
                        // dev_e2e Mac Catalyst stage unlocks on this same pool.
                        sh 'security unlock-keychain -p ${KEYCHAIN_PASSWORD} ~/Library/Keychains/login.keychain-db'
                        echo "=== Run Dotnet macOS Tests"
                        // The label matches a shared pool and the test server binds
                        // fixed localhost ports, so serialize per node as dev_e2e does.
                        lock("${env.NODE_NAME}") {
                            timeout(time: 120, unit: 'MINUTES') {
                                sh "jenkins/pipelines/QE/dotnet/run_test.sh ${params.CBL_VERSION} macos ${params.SGW_VERSION} --dataset-version ${params.TS_DATASET_VERSION} --test-filter '${params.TS_TEST_FILTER}'"
                            }
                        }
                        echo "=== Dotnet macOS Tests Complete"
                    }
                    post {
                        always {
                            // Publish pytest's JUnit XML so per-test failures (messages and
                            // tracebacks) are surfaced in Jenkins even if teardown fails.
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true

                            echo "=== Teardown Dotnet macOS Tests"
                            timeout(time: 5, unit: 'MINUTES') {
                                sh 'jenkins/pipelines/QE/dotnet/teardown.sh'
                            }
                            archiveArtifacts artifacts: 'tests/QE/dotnet_macos/**/*', fingerprint: true, allowEmptyArchive: true
                            echo "=== Dotnet macOS Test Teardown Complete"
                        }
                    }
                }
                stage('iOS') {
                    when { beforeAgent true; expression { params.RUN_IOS } }
                    agent { label 'mob-e2e-iphone-03' }
                    options {
                        // Lock on the node, not the device id: that is the name the
                        // dev_e2e ios/c/dotnet jobs sharing this iPhone lock on.
                        lock('mob-e2e-iphone-03')
                    }
                    environment {
                        KEYCHAIN_PASSWORD = credentials("${env.NODE_NAME}-keychain-password")
                        TS_ARTIFACTS_DIR = 'dotnet_ios'
                    }
                    steps {
                        sh 'security unlock-keychain -p ${KEYCHAIN_PASSWORD} ~/Library/Keychains/login.keychain-db'
                        echo "=== Run Dotnet iOS Tests"
                        timeout(time: 120, unit: 'MINUTES') {
                            sh "jenkins/pipelines/QE/dotnet/run_test.sh ${params.CBL_VERSION} ios ${params.SGW_VERSION} --dataset-version ${params.TS_DATASET_VERSION} --test-filter '${params.TS_TEST_FILTER}'"
                        }
                        echo "=== Dotnet iOS Tests Complete"
                    }
                    post {
                        always {
                            // Publish pytest's JUnit XML so per-test failures (messages and
                            // tracebacks) are surfaced in Jenkins even if teardown fails.
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true

                            echo "=== Teardown Dotnet iOS Tests"
                            timeout(time: 5, unit: 'MINUTES') {
                                sh 'jenkins/pipelines/QE/dotnet/teardown.sh'
                            }
                            archiveArtifacts artifacts: 'tests/QE/dotnet_ios/**/*', fingerprint: true, allowEmptyArchive: true
                            echo "=== Dotnet iOS Test Teardown Complete"
                        }
                    }
                }
                stage('Android') {
                    when { beforeAgent true; expression { params.RUN_ANDROID } }
                    agent { label 'mob-e2e-android-01' }
                    options {
                        lock('mob-e2e-android-01')
                    }
                    environment {
                        // No ANDROID_SERIAL: the bridge always passes `-s <location>`
                        // from the topology. SDK and JDK come from the node, as the
                        // dev_e2e android jobs on this same node rely on.
                        TS_ARTIFACTS_DIR = 'dotnet_android'
                    }
                    steps {
                        echo "=== Run Dotnet Android Tests"
                        timeout(time: 120, unit: 'MINUTES') {
                            sh "jenkins/pipelines/QE/dotnet/run_test.sh ${params.CBL_VERSION} android ${params.SGW_VERSION} --dataset-version ${params.TS_DATASET_VERSION} --test-filter '${params.TS_TEST_FILTER}'"
                        }
                        echo "=== Dotnet Android Tests Complete"
                    }
                    post {
                        always {
                            // Publish pytest's JUnit XML so per-test failures (messages and
                            // tracebacks) are surfaced in Jenkins even if teardown fails.
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true

                            echo "=== Teardown Dotnet Android Tests"
                            timeout(time: 5, unit: 'MINUTES') {
                                sh 'jenkins/pipelines/QE/dotnet/teardown.sh'
                            }
                            archiveArtifacts artifacts: 'tests/QE/dotnet_android/**/*', fingerprint: true, allowEmptyArchive: true
                            echo "=== Dotnet Android Test Teardown Complete"
                        }
                    }
                }
            }
        }
    }
    post {
        failure {
            mail bcc: '', body: "Project: <a href='${env.BUILD_URL}'>${env.JOB_NAME}</a> has failed!", cc: '', charset: 'UTF-8', from: 'jenkins@couchbase.com', mimeType: 'text/html', replyTo: 'no-reply@couchbase.com', subject: "${env.JOB_NAME} failed", to: "sanjivani.patra@couchbase.com";
        }
        fixed {
            mail bcc: '', body: "Project: <a href='${env.BUILD_URL}'>${env.JOB_NAME}</a> is back to normal (fixed).", cc: '', charset: 'UTF-8', from: 'jenkins@couchbase.com', mimeType: 'text/html', replyTo: 'no-reply@couchbase.com', subject: "${env.JOB_NAME} fixed", to: "sanjivani.patra@couchbase.com";
        }
    }
}