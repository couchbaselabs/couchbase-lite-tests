def SGW_PRODUCT = "sync-gateway"          // dedup key: the thing under test
def CBL_PRODUCT = "couchbase-lite-c"      // c_macos test-server client, passed through
// CBL 4.x cannot sync with Sync Gateway 3.x, so an auto-resolved client is swapped for
// the latest GA build of this train on the SGW trains that need it.
def LEGACY_CBL_TRAIN = "3"

pipeline {
    // Pinned: dedup state lives on this node's filesystem (~/.jenkins_build_info).
    agent { label 'mac-mini-new' }
    environment {
        PATH = "/opt/homebrew/opt/python@3.10/bin:/opt/homebrew/bin:/usr/local/bin:${env.PATH}"
    }
    parameters {
        string(name: 'SGW_VERSION', defaultValue: '', description: 'Sync Gateway version or train (e.g. 4.2.0 or 4.2). Leave blank to auto-resolve and test the latest build of EVERY non-EOL train from ProGet get_trains. The build number is resolved automatically.')
        string(name: 'CBL_VERSION', defaultValue: '', description: 'CBL C client version (e.g. 4.2.0). Leave blank to auto-resolve the latest GA release via ProGet (prereleases are deliberately excluded so the client stays a fixed control); SGW 3.x trains then get the latest GA CBL 3.x client, since CBL 4.x cannot sync with SGW 3.x. An explicit version is never swapped: SGW trains it cannot sync with are skipped. The build number is resolved automatically.')
        booleanParam(name: 'FORCE_TRIGGER', defaultValue: false, description: 'Force triggering the SGW test job even if this SGW version+build already ran')
    }
    options {
        ansiColor('xterm')
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
    }
    triggers {
        cron('''TZ=Asia/Kolkata
0 4 * * *''')
    }
    stages {
        stage('Resolve and Trigger') {
            steps {
                script {
                    def proget = load 'jenkins/pipelines/shared/resolveProgetVersion.groovy'
                    def builds = load 'jenkins/pipelines/shared/progetBuilds.groovy'
                    def triggers = load 'jenkins/pipelines/shared/triggerRecord.groovy'
                    def compat = load 'jenkins/pipelines/shared/cblSgwCompatibility.groovy'

                    // The CBL client is shared across all SGW trains it can sync with, and is
                    // pinned to the latest GA build -- never a prerelease -- so it stays a
                    // fixed control.
                    def cbl = builds.resolveVersionBuild(proget, CBL_PRODUCT, params.CBL_VERSION, 'CBL_VERSION', false)
                    // Unlike a train, the client has no fallback: without it there is
                    // nothing to run the suite with, so an unresolved CBL is fatal.
                    if (cbl == null) { error "Could not resolve a published build for ${CBL_PRODUCT}" }
                    def cblFull = "${cbl.version}-${cbl.build}"
                    echo "CBL (client): ${cblFull}"
                    echo "FORCE: ${params.FORCE_TRIGGER}"

                    // A specific SGW_VERSION param targets one train/version; a blank
                    // param fans out over every non-EOL train from get_trains.
                    def trains
                    if (params.SGW_VERSION?.trim()) {
                        trains = [params.SGW_VERSION.trim()]
                    } else {
                        trains = builds.fetchTrains(SGW_PRODUCT)
                        if (!trains) { error "No SGW trains returned from ProGet get_trains" }
                    }
                    echo "SGW trains to process: ${trains}"

                    // Dedup on the SGW build only; the CBL client is not part of the key.
                    def buildInfo = triggers.readRecord('sgw')

                    def triggered = []
                    def skipped = []
                    def failed = []
                    // Resolved on first need, then shared by every SGW 3.x train.
                    def legacyCbl = null

                    for (train in trains) {
                        def sgw
                        try {
                            sgw = builds.resolveVersionBuild(proget, SGW_PRODUCT, train, 'SGW_VERSION', true)
                        } catch (Exception e) {
                            echo "WARN: Could not resolve SGW train ${train}: ${e}"
                            failed << train
                            continue
                        }
                        if (sgw == null) {
                            // No published build yet (new train) — normal, not a failure.
                            echo "SKIP: SGW train ${train} — no published build yet"
                            skipped << "${train} (no build)"
                            continue
                        }
                        def sgwFull = "${sgw.version}-${sgw.build}"

                        if (!params.FORCE_TRIGGER && triggers.alreadyTriggered(buildInfo, sgw.version, sgw.build)) {
                            echo "SKIP: SGW ${sgwFull} (already triggered)"
                            skipped << sgwFull
                            continue
                        }

                        def client = cbl
                        def reason = compat.incompatibility(cblFull, sgwFull)
                        if (reason) {
                            if (params.CBL_VERSION?.trim()) {
                                echo "SKIP: ${reason}"
                                skipped << "${sgwFull} (incompatible with CBL ${cblFull})"
                                continue
                            }
                            if (legacyCbl == null) {
                                try {
                                    legacyCbl = builds.resolveVersionBuild(proget, CBL_PRODUCT, LEGACY_CBL_TRAIN, 'CBL_VERSION', false)
                                } catch (Exception e) {
                                    echo "WARN: Could not resolve CBL ${LEGACY_CBL_TRAIN}.x client: ${e}"
                                }
                            }
                            if (legacyCbl == null) {
                                echo "WARN: ${reason}, and no CBL ${LEGACY_CBL_TRAIN}.x client could be resolved"
                                failed << train
                                continue
                            }
                            client = legacyCbl
                        }
                        def clientFull = "${client.version}-${client.build}"
                        def clientDataset = (client.version.tokenize('.')[0].toInteger() >= 4) ? "4.0" : "3.2"

                        echo "Triggering 'sgw-functional' for SGW ${sgwFull} (CBL client ${clientFull}, dataset ${clientDataset})"
                        build job: 'sgw-functional', parameters: [
                            string(name: "SGW_VERSION", value: sgwFull),
                            string(name: "CBL_VERSION", value: clientFull),
                            string(name: "TS_DATASET_VERSION", value: clientDataset)
                        ], wait: false

                        buildInfo[sgw.version] = sgw.build
                        triggered << "${sgwFull} (CBL ${clientFull})"
                    }

                    // Persist dedup state once, after all trains are processed.
                    if (triggered) { triggers.saveRecord('sgw', buildInfo) }

                    currentBuild.displayName = "SGW ${triggered ? triggered.join(', ') : 'none'}  (#${currentBuild.number})"
                    echo "Triggered: ${triggered}"
                    echo "Skipped:   ${skipped}"
                    echo "Failed:    ${failed}"

                    if (failed) {
                        currentBuild.result = 'UNSTABLE'
                        echo "WARNING: ${failed.size()} train(s) failed to resolve: ${failed}"
                    }
                }
            }
        }
    }
}
