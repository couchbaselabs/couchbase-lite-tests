// Functional tests for Couchbase Lite Swift on an iPhone in the U.S. lab.
// Merges the former dev_e2e/ios and QE/ios pipelines.
def IOS_NODE = 'mob-e2e-iphone-03'
def MAIL_TO = 'sanjivani.patra@couchbase.com,pasin@couchbase.com,vlad.velicu@couchbase.com'

pipeline {
    agent none
    parameters {
        string(name: 'CBL_VERSION', defaultValue: '', description: 'Couchbase Lite version, e.g. 4.0.0')
        string(name: 'CBL_BUILD', defaultValue: '', description: 'Couchbase Lite build number (empty: latest build of CBL_VERSION)')
        string(name: 'SGW_VERSION', defaultValue: '', description: 'Sync Gateway version to download (a prefix such as 4 resolves to the latest release)')
        choice(name: 'TS_DATASET_VERSION', choices: ['auto', '4.0', '3.2'], description: 'Test server dataset version (auto: 3.2 for CBL 3.x, else 4.0)')
        string(name: 'TS_TEST_FILTER', defaultValue: '', description: 'An optional pytest -k filter for running a subset of tests (disables result upload)')
        booleanParam(name: 'RUN_PREBUILD', defaultValue: true, description: 'Prebuild the test server. Uncheck to skip prebuild entirely and reuse existing artifacts.')
    }
    options {
        ansiColor('xterm')
        timestamps()
    }
    stages {
        stage('Init') {
            agent any
            steps {
                script {
                    if (params.CBL_VERSION == '') { error "CBL_VERSION is required" }
                    if (params.SGW_VERSION == '') { error "SGW_VERSION is required" }
                    def compat = load 'jenkins/pipelines/shared/cblSgwCompatibility.groovy'
                    def reason = compat.incompatibility(params.CBL_VERSION, params.SGW_VERSION)
                    if (reason) { error reason }

                    env.FULL_CBL_VERSION = params.CBL_BUILD ? "${params.CBL_VERSION}-${params.CBL_BUILD}" : params.CBL_VERSION
                    // 'auto' picks the dataset from CBL_VERSION: 3.x uses the 3.2 dataset, else 4.0
                    env.DATASET_VERSION = params.TS_DATASET_VERSION != 'auto' ? params.TS_DATASET_VERSION :
                        (params.CBL_VERSION.startsWith('3.') ? '3.2' : '4.0')
                    currentBuild.displayName = "iOS CBL:${env.FULL_CBL_VERSION} (#${currentBuild.number})"
                    currentBuild.description = "SGW: ${params.SGW_VERSION}, DS: ${env.DATASET_VERSION}"
                }
            }
        }
        stage('Prebuild Server') {
            when { beforeAgent true; expression { params.RUN_PREBUILD } }
            steps {
                build job: 'prebuild-test-server',
                parameters: [
                    string(name: 'TS_PLATFORM', value: 'swift_ios'),
                    string(name: 'CBL_VERSION', value: params.CBL_VERSION),
                    string(name: 'CBL_BUILD', value: params.CBL_BUILD)
                ],
                wait: true,
                propagate: true
            }
        }
        stage('iOS') {
            agent { label IOS_NODE }
            options {
                // Every job sharing this iPhone locks on the node name; without it a
                // concurrent build would install over this run's test server.
                lock(IOS_NODE)
            }
            environment {
                KEYCHAIN_PASSWORD = credentials("${env.NODE_NAME}-keychain-password")
                TS_ARTIFACTS_DIR = 'ios'
            }
            steps {
                sh 'security unlock-keychain -p ${KEYCHAIN_PASSWORD} ~/Library/Keychains/login.keychain-db'
                timeout(time: 120, unit: 'MINUTES') {
                    sh "jenkins/pipelines/functional/ios/test.sh '${env.FULL_CBL_VERSION}' '${params.SGW_VERSION}' --dataset-version ${env.DATASET_VERSION} --test-filter '${params.TS_TEST_FILTER}'"
                }
            }
            post {
                always {
                    // Publish pytest's JUnit XML so per-test failures (messages and
                    // tracebacks) are surfaced in Jenkins even if teardown fails.
                    junit testResults: '**/junit_result.xml', allowEmptyResults: true
                    timeout(time: 5, unit: 'MINUTES') {
                        sh 'jenkins/pipelines/functional/ios/teardown.sh'
                    }
                    archiveArtifacts artifacts: 'tests/functional/ios/**/*', fingerprint: true, allowEmptyArchive: true
                }
            }
        }
    }
    post {
        failure {
            mail bcc: '', body: "Project: <a href='${env.BUILD_URL}'>${env.JOB_NAME}</a> has failed!", cc: '', charset: 'UTF-8', from: 'jenkins@couchbase.com', mimeType: 'text/html', replyTo: 'no-reply@couchbase.com', subject: "${env.JOB_NAME} failed", to: MAIL_TO
        }
        fixed {
            mail bcc: '', body: "Project: <a href='${env.BUILD_URL}'>${env.JOB_NAME}</a> is back to normal (fixed).", cc: '', charset: 'UTF-8', from: 'jenkins@couchbase.com', mimeType: 'text/html', replyTo: 'no-reply@couchbase.com', subject: "${env.JOB_NAME} fixed", to: MAIL_TO
        }
    }
}
