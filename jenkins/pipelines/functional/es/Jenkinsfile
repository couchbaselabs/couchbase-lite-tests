// Runs every tests/functional test marked min_edge_servers against one Edge Server build.
// jenkins/pipelines/main/es triggers it daily for new builds; it can also be run by hand.

pipeline {
    agent none
    parameters {
        string(name: 'ES_VERSION', defaultValue: '', description: 'Edge Server version under test (required): version-build, version or train (e.g. 1.1.1-5, 1.1.1 or 1.1). The build number is resolved automatically.')
        string(name: 'TEST_NAME', defaultValue: '.', description: '"." runs every tests/functional test marked min_edge_servers; anything else is passed to pytest -k')
        string(name: 'TOPOLOGY_NAME', defaultValue: 'es_sgw_topology.json', description: 'Topology file name. 3es_1sgw_1js_topology.json also runs a CBL-JS test server on the Jenkins agent (localhost).')
        string(name: 'CBL_VERSION', defaultValue: '', description: 'CBL-JS version-build, version or train for a topology with a JS test server (e.g. 1.1.0-25). Leave blank for the newest build. Ignored for topologies without test servers.')
        booleanParam(name: 'RUN_PREBUILD', defaultValue: true, description: 'Prebuild the JS test server for CBL_VERSION. Uncheck to reuse existing artifacts.')
        string(name: 'SGW_VERSION', defaultValue: '', description: 'Sync Gateway version (leave empty for the latest GA release)')
        string(name: 'CBS_VERSION', defaultValue: '', description: 'Couchbase Server version (leave empty for the latest GA release)')
        string(name: 'TS_DATASET_VERSION', defaultValue: '4.0', description: 'The version of the dataset to use on the test servers')
        booleanParam(name: 'JS_REPLICATION_TESTS_ONLY', defaultValue: false, description: 'Run only the tests that replicate with the CBL-JS test server (those marked both min_edge_servers and min_test_servers). Needs a topology with a JS test server. TEST_NAME still narrows them with -k.')
    }
    options {
        ansiColor('xterm')
        timestamps()
    }
    stages {
        stage('Resolve Versions') {
            agent { label 'mac-mini-new' }
            environment {
                PATH = "/opt/homebrew/opt/python@3.10/bin:/opt/homebrew/bin:/usr/local/bin:${env.PATH}"
            }
            steps {
                script {
                    if (!params.ES_VERSION?.trim()) { error "ES_VERSION is required: it is the version of the product under test" }
                    if (params.TEST_NAME == '') { error "TEST_NAME is required" }
                    def hasJs = params.TOPOLOGY_NAME.contains('js_topology')
                    if (params.JS_REPLICATION_TESTS_ONLY && !hasJs) {
                        error "JS_REPLICATION_TESTS_ONLY needs a topology with a JS test server (e.g. 3es_1sgw_1js_topology.json); ${params.TOPOLOGY_NAME} has none, so every selected test would be skipped"
                    }

                    def proget = load 'jenkins/pipelines/shared/resolveProgetVersion.groovy'
                    def builds = load 'jenkins/pipelines/shared/progetBuilds.groovy'
                    def es = builds.resolveVersionBuild(proget, 'couchbase-edge-server', params.ES_VERSION, 'ES_VERSION', true)
                    if (es == null) { error "ES_VERSION: couchbase-edge-server ${params.ES_VERSION} has no published build yet" }
                    env.ES_FULL = "${es.version}-${es.build}"
                    env.CBL_FULL = ''
                    if (hasJs) {
                        def cbl = builds.resolveVersionBuild(proget, 'couchbase-lite-js', params.CBL_VERSION, 'CBL_VERSION', true)
                        if (cbl == null) { error "CBL_VERSION: couchbase-lite-js ${params.CBL_VERSION} has no published build yet" }
                        env.CBL_FULL = "${cbl.version}-${cbl.build}"
                    }
                    echo "Edge Server: ${env.ES_FULL}  |  CBL-JS: ${env.CBL_FULL ?: 'none'}"

                    def scope = params.JS_REPLICATION_TESTS_ONLY ? "JS replication only" : "all"
                    currentBuild.displayName = "ES:${env.ES_FULL} (#${currentBuild.number})"
                    currentBuild.description = "${scope}: ${params.TEST_NAME} | SGW: ${params.SGW_VERSION ?: 'latest GA'} | CBS: ${params.CBS_VERSION ?: 'latest GA'} | CBL-JS: ${env.CBL_FULL ?: 'none'}"
                }
            }
        }
        stage('Prebuild JS Test Server') {
            when { beforeAgent true; expression { env.CBL_FULL && params.RUN_PREBUILD } }
            steps {
                script {
                    def (cblVersion, cblBuild) = env.CBL_FULL.tokenize('-')
                    build job: 'prebuild-test-server',
                    parameters: [
                        string(name: 'TS_PLATFORM', value: 'js'),
                        string(name: 'CBL_VERSION', value: cblVersion),
                        string(name: 'CBL_BUILD', value: cblBuild)
                    ],
                    wait: true,
                    propagate: true
                }
            }
        }
        stage('Run Test') {
            agent { label 'mac-mini-new' }
            environment {
                KEYCHAIN_PASSWORD = credentials('mobile-qe')
                PATH = "/opt/homebrew/opt/python@3.10/bin:/opt/homebrew/bin:/usr/local/bin:${env.PATH}"
                TS_ARTIFACTS_DIR = 'es'
                TS_DATASET_VERSION = "${params.TS_DATASET_VERSION}"
            }
            steps {
                // Unlock keychain:
                sh 'security unlock-keychain -p ${KEYCHAIN_PASSWORD} ~/Library/Keychains/login.keychain-db'
                echo "=== Run Edge server Tests"
                timeout(time: 90, unit: 'MINUTES') {
                    sh """
                        jenkins/pipelines/functional/es/test.sh \
                            "${env.ES_FULL}" \
                            "${params.TEST_NAME}" \
                            "${params.TOPOLOGY_NAME}" \
                            "${params.SGW_VERSION}" \
                            "${params.CBS_VERSION}" \
                            "${params.TS_DATASET_VERSION}" \
                            "${env.CBL_FULL}" \
                            "${params.JS_REPLICATION_TESTS_ONLY}"
                    """
                }
                echo "=== Edge server Tests Complete"
            }
            post {
                always {
                    // Publish pytest's JUnit XML so per-test failures (messages and
                    // tracebacks) are surfaced in Jenkins even if teardown fails.
                    junit testResults: '**/junit_result.xml', allowEmptyResults: true

                    echo "=== Teardown Edge server Tests"
                    timeout(time: 5, unit: 'MINUTES') {
                        sh "jenkins/pipelines/functional/es/teardown.sh"
                    }
                    archiveArtifacts artifacts: 'tests/functional/es/**', fingerprint: true, allowEmptyArchive: true
                    echo "=== Edge server Test Teardown Complete"
                }
            }
        }
    }
}