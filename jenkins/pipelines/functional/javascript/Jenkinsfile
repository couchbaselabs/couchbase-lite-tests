pipeline {
    agent none
    parameters {
        string(name: 'CBL_VERSION', defaultValue: '', description: 'CBL-JS version under test (required): 1, 1.1, 1.1.0 or 1.1.0-25')
        string(name: 'SGW_VERSION', defaultValue: '', description: 'Sync Gateway version: 4, 4.1, 4.1.0 or 4.1.0-18 (empty: the latest release)')
        string(name: 'ES_VERSION', defaultValue: '', description: 'Edge Server version: 1, 1.1, 1.1.1 or 1.1.1-5 (empty: the latest release)')
        string(name: 'TS_TEST_FILTER', defaultValue: '', description: 'An optional pytest -k filter for running a subset of tests (disables result upload)')
        booleanParam(name: 'RUN_PREBUILD', defaultValue: true, description: 'Prebuild the test server. Uncheck to skip prebuild entirely and reuse existing artifacts.')
    }
    options {
        ansiColor('xterm')
        timestamps()
    }
    stages {
        stage('Init') {
            agent any
            steps {
                script {
                    def versions = load 'jenkins/pipelines/shared/productVersions.groovy'
                    versions.resolve('cbl', 'couchbase-lite-js', params)
                    currentBuild.displayName = "JS CBL:${env.CBL_RESOLVED} (#${currentBuild.number})"
                    currentBuild.description = "SGW: ${env.SGW_RESOLVED}, ES: ${env.ES_RESOLVED}"
                }
            }
        }
        stage('Prebuild Server') {
            when { beforeAgent true; expression { params.RUN_PREBUILD } }
            steps {
                script {
                    build job: 'prebuild-test-server',
                    parameters: [
                        string(name: 'TS_PLATFORM', value: 'js'),
                        string(name: 'CBL_VERSION', value: env.CBL_PREBUILD_VERSION),
                        string(name: 'CBL_BUILD', value: env.CBL_PREBUILD_BUILD)
                    ],
                    wait: true,
                    propagate: true
                }
            }
        }
        stage('Run Test') {
            agent { label 'e2e&&macos-host' }
            environment {
                TS_ARTIFACTS_DIR = 'js'
            }
            steps {
                lock("${env.NODE_NAME}") {
                    timeout(time: 120, unit: 'MINUTES') {
                        sh "jenkins/pipelines/functional/javascript/test.sh '${env.CBL_RESOLVED}' '${env.SGW_RESOLVED}' --es-version '${env.ES_RESOLVED}' --test-filter '${params.TS_TEST_FILTER}'"
                    }
                }
            }
            post { 
                always {
                    junit testResults: '**/junit_result.xml', allowEmptyResults: true

                    echo "Teardown JavaScript Test"
                    timeout(time: 5, unit: 'MINUTES') {
                        sh 'jenkins/pipelines/functional/javascript/teardown.sh'
                    }
                    archiveArtifacts artifacts: 'tests/functional/js/**/*', fingerprint: true, allowEmptyArchive: true
                }
            }
        }
    }
    post {
        failure {
            mail bcc: '', body: "Project: <a href='${env.BUILD_URL}'>${env.JOB_NAME}</a> has failed!", cc: '', charset: 'UTF-8', from: 'jenkins@couchbase.com', mimeType: 'text/html', replyTo: 'no-reply@couchbase.com', subject: "${env.JOB_NAME} failed", to: "pasin@couchbase.com";
        }
    }
}