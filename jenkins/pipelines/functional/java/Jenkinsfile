// Functional tests for Couchbase Lite Java (Desktop and Web Service) on the
// shared e2e host pools. Merges the former dev_e2e/java and QE/java pipelines.
def MAIL_TO = 'blake.meike@couchbase.com,barkha.goyal@couchbase.com'

pipeline {
    agent none
    parameters {
        string(name: 'CBL_VERSION', defaultValue: '', description: 'Couchbase Lite version, e.g. 4.0.0')
        string(name: 'CBL_BUILD', defaultValue: '', description: 'Couchbase Lite build number (empty: latest build of CBL_VERSION)')
        string(name: 'SGW_VERSION', defaultValue: '', description: 'Sync Gateway version to download (a prefix such as 4 resolves to the latest release)')
        choice(name: 'TS_DATASET_VERSION', choices: ['auto', '4.0', '3.2'], description: 'Test server dataset version (auto: 3.2 for CBL 3.x, else 4.0)')
        string(name: 'TS_TEST_FILTER', defaultValue: '', description: 'An optional pytest -k filter for running a subset of tests (disables result upload)')
        booleanParam(name: 'RUN_PREBUILD', defaultValue: true, description: 'Prebuild test servers (only for the checked platforms). Uncheck to skip prebuild entirely and reuse existing artifacts.')
        booleanParam(name: 'RUN_MACOS_DESKTOP',      defaultValue: true, description: 'Run macOS Desktop tests')
        booleanParam(name: 'RUN_WINDOWS_DESKTOP',    defaultValue: true, description: 'Run Windows Desktop tests')
        booleanParam(name: 'RUN_LINUX_DESKTOP',      defaultValue: true, description: 'Run Linux Desktop tests')
        booleanParam(name: 'RUN_MACOS_WEBSERVICE',   defaultValue: true, description: 'Run macOS Web Service tests')
        booleanParam(name: 'RUN_WINDOWS_WEBSERVICE', defaultValue: true, description: 'Run Windows Web Service tests')
        booleanParam(name: 'RUN_LINUX_WEBSERVICE',   defaultValue: true, description: 'Run Linux Web Service tests')
    }
    options {
        ansiColor('xterm')
        timestamps()
        timeout(time: 150, unit: 'MINUTES')
    }
    stages {
        stage('Init') {
            agent any
            steps {
                script {
                    if (params.CBL_VERSION == '') { error "CBL_VERSION is required" }
                    if (params.SGW_VERSION == '') { error "SGW_VERSION is required" }
                    def compat = load 'jenkins/pipelines/shared/cblSgwCompatibility.groovy'
                    def reason = compat.incompatibility(params.CBL_VERSION, params.SGW_VERSION)
                    if (reason) { error reason }

                    env.FULL_CBL_VERSION = params.CBL_BUILD ? "${params.CBL_VERSION}-${params.CBL_BUILD}" : params.CBL_VERSION
                    // 'auto' picks the dataset from CBL_VERSION: 3.x uses the 3.2 dataset, else 4.0
                    env.DATASET_VERSION = params.TS_DATASET_VERSION != 'auto' ? params.TS_DATASET_VERSION :
                        (params.CBL_VERSION.startsWith('3.') ? '3.2' : '4.0')
                    currentBuild.displayName = "Java CBL:${env.FULL_CBL_VERSION} (#${currentBuild.number})"
                    currentBuild.description = "SGW: ${params.SGW_VERSION}, DS: ${env.DATASET_VERSION}"
                }
            }
        }
        stage('Prebuild Servers') {
            when { beforeAgent true; expression { params.RUN_PREBUILD } }
            steps {
                script {
                    // Each server flavor is prebuilt only when at least one of its
                    // test stages is selected.
                    def anyDesktop = params.RUN_MACOS_DESKTOP || params.RUN_WINDOWS_DESKTOP || params.RUN_LINUX_DESKTOP
                    def anyWebService = params.RUN_MACOS_WEBSERVICE || params.RUN_WINDOWS_WEBSERVICE || params.RUN_LINUX_WEBSERVICE

                    def platforms = []
                    if (anyDesktop)    { platforms << 'jak_desktop' }
                    if (anyWebService) { platforms << 'jak_webservice' }
                    if (platforms.isEmpty()) {
                        echo "No platforms selected — nothing to prebuild"
                    } else {
                        def parallelBuilds = [:]
                        for (p in platforms) {
                            // Copy to a local so each closure keeps its own platform
                            def platform = p
                            parallelBuilds[platform] = {
                                build job: 'prebuild-test-server',
                                parameters: [
                                    string(name: 'TS_PLATFORM', value: platform),
                                    string(name: 'CBL_VERSION', value: params.CBL_VERSION),
                                    string(name: 'CBL_BUILD', value: params.CBL_BUILD)
                                ],
                                wait: true,
                                propagate: true
                            }
                        }
                        parallel parallelBuilds
                    }
                }
            }
        }
        // Each label matches a shared pool and the test server binds fixed localhost
        // ports, so every stage serializes per node.
        stage('Run Tests') {
            parallel {
                stage('macOS Desktop') {
                    when { beforeAgent true; expression { params.RUN_MACOS_DESKTOP } }
                    agent { label 'e2e&&macos-host' }
                    environment {
                        TS_ARTIFACTS_DIR = 'java_macos_desktop'
                    }
                    steps {
                        lock("${env.NODE_NAME}") {
                            timeout(time: 120, unit: 'MINUTES') {
                                sh "jenkins/pipelines/functional/java/desktop/run_test.sh '${env.FULL_CBL_VERSION}' '${params.SGW_VERSION}' --dataset-version ${env.DATASET_VERSION} --test-filter '${params.TS_TEST_FILTER}'"
                            }
                        }
                    }
                    post {
                        always {
                            // Publish pytest's JUnit XML so per-test failures (messages and
                            // tracebacks) are surfaced in Jenkins even if teardown fails.
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true
                            timeout(time: 5, unit: 'MINUTES') {
                                sh 'jenkins/pipelines/functional/java/desktop/teardown.sh'
                            }
                            archiveArtifacts artifacts: 'tests/functional/java_macos_desktop/**/*', fingerprint: true, allowEmptyArchive: true
                        }
                    }
                }
                stage('Windows Desktop') {
                    when { beforeAgent true; expression { params.RUN_WINDOWS_DESKTOP } }
                    agent { label 'e2e&&windows-host' }
                    environment {
                        TS_ARTIFACTS_DIR = 'java_windows_desktop'
                    }
                    steps {
                        lock("${env.NODE_NAME}") {
                            timeout(time: 120, unit: 'MINUTES') {
                                pwsh "jenkins\\pipelines\\functional\\java\\desktop\\run_test.ps1 -Version '${env.FULL_CBL_VERSION}' -SgwVersion '${params.SGW_VERSION}' -DatasetVersion ${env.DATASET_VERSION} -TestFilter '${params.TS_TEST_FILTER}'"
                            }
                        }
                    }
                    post {
                        always {
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true
                            timeout(time: 5, unit: 'MINUTES') {
                                pwsh 'jenkins\\pipelines\\functional\\java\\desktop\\teardown.ps1'
                            }
                            archiveArtifacts artifacts: 'tests/functional/java_windows_desktop/**/*', fingerprint: true, allowEmptyArchive: true
                        }
                    }
                }
                stage('Linux Desktop') {
                    when { beforeAgent true; expression { params.RUN_LINUX_DESKTOP } }
                    agent { label 'e2e&&linux-host' }
                    environment {
                        TS_ARTIFACTS_DIR = 'java_linux_desktop'
                    }
                    steps {
                        lock("${env.NODE_NAME}") {
                            timeout(time: 120, unit: 'MINUTES') {
                                sh "jenkins/pipelines/functional/java/desktop/run_test.sh '${env.FULL_CBL_VERSION}' '${params.SGW_VERSION}' --dataset-version ${env.DATASET_VERSION} --test-filter '${params.TS_TEST_FILTER}'"
                            }
                        }
                    }
                    post {
                        always {
                            // Publish pytest's JUnit XML so per-test failures (messages and
                            // tracebacks) are surfaced in Jenkins even if teardown fails.
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true
                            timeout(time: 5, unit: 'MINUTES') {
                                sh 'jenkins/pipelines/functional/java/desktop/teardown.sh'
                            }
                            archiveArtifacts artifacts: 'tests/functional/java_linux_desktop/**/*', fingerprint: true, allowEmptyArchive: true
                        }
                    }
                }
                stage('macOS Web Service') {
                    when { beforeAgent true; expression { params.RUN_MACOS_WEBSERVICE } }
                    agent { label 'e2e&&macos-host' }
                    environment {
                        TS_ARTIFACTS_DIR = 'java_macos_webservice'
                    }
                    steps {
                        lock("${env.NODE_NAME}") {
                            timeout(time: 120, unit: 'MINUTES') {
                                sh "jenkins/pipelines/functional/java/webservice/run_test.sh '${env.FULL_CBL_VERSION}' '${params.SGW_VERSION}' --dataset-version ${env.DATASET_VERSION} --test-filter '${params.TS_TEST_FILTER}'"
                            }
                        }
                    }
                    post {
                        always {
                            // Publish pytest's JUnit XML so per-test failures (messages and
                            // tracebacks) are surfaced in Jenkins even if teardown fails.
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true
                            timeout(time: 5, unit: 'MINUTES') {
                                sh 'jenkins/pipelines/functional/java/webservice/teardown.sh'
                            }
                            archiveArtifacts artifacts: 'tests/functional/java_macos_webservice/**/*', fingerprint: true, allowEmptyArchive: true
                        }
                    }
                }
                stage('Windows Web Service') {
                    when { beforeAgent true; expression { params.RUN_WINDOWS_WEBSERVICE } }
                    agent { label 'e2e&&windows-host' }
                    environment {
                        TS_ARTIFACTS_DIR = 'java_windows_webservice'
                    }
                    steps {
                        lock("${env.NODE_NAME}") {
                            timeout(time: 120, unit: 'MINUTES') {
                                pwsh "jenkins\\pipelines\\functional\\java\\webservice\\run_test.ps1 -Version '${env.FULL_CBL_VERSION}' -SgwVersion '${params.SGW_VERSION}' -DatasetVersion ${env.DATASET_VERSION} -TestFilter '${params.TS_TEST_FILTER}'"
                            }
                        }
                    }
                    post {
                        always {
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true
                            timeout(time: 5, unit: 'MINUTES') {
                                pwsh 'jenkins\\pipelines\\functional\\java\\webservice\\teardown.ps1'
                            }
                            archiveArtifacts artifacts: 'tests/functional/java_windows_webservice/**/*', fingerprint: true, allowEmptyArchive: true
                        }
                    }
                }
                stage('Linux Web Service') {
                    when { beforeAgent true; expression { params.RUN_LINUX_WEBSERVICE } }
                    agent { label 'e2e&&linux-host' }
                    environment {
                        TS_ARTIFACTS_DIR = 'java_linux_webservice'
                    }
                    steps {
                        lock("${env.NODE_NAME}") {
                            timeout(time: 120, unit: 'MINUTES') {
                                sh "jenkins/pipelines/functional/java/webservice/run_test.sh '${env.FULL_CBL_VERSION}' '${params.SGW_VERSION}' --dataset-version ${env.DATASET_VERSION} --test-filter '${params.TS_TEST_FILTER}'"
                            }
                        }
                    }
                    post {
                        always {
                            // Publish pytest's JUnit XML so per-test failures (messages and
                            // tracebacks) are surfaced in Jenkins even if teardown fails.
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true
                            timeout(time: 5, unit: 'MINUTES') {
                                sh 'jenkins/pipelines/functional/java/webservice/teardown.sh'
                            }
                            archiveArtifacts artifacts: 'tests/functional/java_linux_webservice/**/*', fingerprint: true, allowEmptyArchive: true
                        }
                    }
                }
            }
        }
    }
    post {
        failure {
            mail bcc: '', body: "Project: <a href='${env.BUILD_URL}'>${env.JOB_NAME}</a> has failed!", cc: '', charset: 'UTF-8', from: 'jenkins@couchbase.com', mimeType: 'text/html', replyTo: 'no-reply@couchbase.com', subject: "${env.JOB_NAME} failed", to: MAIL_TO
        }
        fixed {
            mail bcc: '', body: "Project: <a href='${env.BUILD_URL}'>${env.JOB_NAME}</a> is back to normal (fixed).", cc: '', charset: 'UTF-8', from: 'jenkins@couchbase.com', mimeType: 'text/html', replyTo: 'no-reply@couchbase.com', subject: "${env.JOB_NAME} fixed", to: MAIL_TO
        }
    }
}
