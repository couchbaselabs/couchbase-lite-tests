// Functional tests for Couchbase Lite .NET on every .NET platform.
// Merges the former dev_e2e/dotnet and QE/dotnet pipelines, using the QE hosts.
def WINDOWS_NODE = 'net-windows'
def IOS_NODE = 'mob-e2e-iphone-03'
def ANDROID_NODE = 'mob-e2e-android-01'
def MAIL_TO = 'sanjivani.patra@couchbase.com,jim.borden@couchbase.com'

pipeline {
    agent none
    parameters {
        string(name: 'CBL_VERSION', defaultValue: '', description: 'Couchbase Lite version, e.g. 4.0.0')
        string(name: 'CBL_BUILD', defaultValue: '', description: 'Couchbase Lite build number (empty: latest build of CBL_VERSION)')
        string(name: 'SGW_VERSION', defaultValue: '', description: 'Sync Gateway version to download (a prefix such as 4 resolves to the latest release)')
        choice(name: 'TS_DATASET_VERSION', choices: ['auto', '4.0', '3.2'], description: 'Test server dataset version (auto: 3.2 for CBL 3.x, else 4.0)')
        string(name: 'TS_TEST_FILTER', defaultValue: '', description: 'An optional pytest -k filter for running a subset of tests (disables result upload)')
        booleanParam(name: 'RUN_PREBUILD', defaultValue: true, description: 'Prebuild test servers (only for the checked platforms). Uncheck to skip prebuild entirely and reuse existing artifacts.')
        booleanParam(name: 'RUN_WINDOWS', defaultValue: true, description: 'Run Windows tests')
        booleanParam(name: 'RUN_MACOS',   defaultValue: true, description: 'Run macOS (Mac Catalyst) tests')
        booleanParam(name: 'RUN_IOS',     defaultValue: true, description: 'Run iOS tests')
        booleanParam(name: 'RUN_ANDROID', defaultValue: true, description: 'Run Android tests')
    }
    options {
        ansiColor('xterm')
        timestamps()
        timeout(time: 150, unit: 'MINUTES')
    }
    stages {
        stage('Init') {
            agent any
            steps {
                script {
                    if (params.CBL_VERSION == '') { error "CBL_VERSION is required" }
                    if (params.SGW_VERSION == '') { error "SGW_VERSION is required" }
                    def compat = load 'jenkins/pipelines/shared/cblSgwCompatibility.groovy'
                    def reason = compat.incompatibility(params.CBL_VERSION, params.SGW_VERSION)
                    if (reason) { error reason }

                    env.FULL_CBL_VERSION = params.CBL_BUILD ? "${params.CBL_VERSION}-${params.CBL_BUILD}" : params.CBL_VERSION
                    // 'auto' picks the dataset from CBL_VERSION: 3.x uses the 3.2 dataset, else 4.0
                    env.DATASET_VERSION = params.TS_DATASET_VERSION != 'auto' ? params.TS_DATASET_VERSION :
                        (params.CBL_VERSION.startsWith('3.') ? '3.2' : '4.0')
                    currentBuild.displayName = "Dotnet CBL:${env.FULL_CBL_VERSION} (#${currentBuild.number})"
                    currentBuild.description = "SGW: ${params.SGW_VERSION}, DS: ${env.DATASET_VERSION}"
                }
            }
        }
        stage('Prebuild Servers') {
            when { beforeAgent true; expression { params.RUN_PREBUILD } }
            steps {
                script {
                    def platforms = []
                    if (params.RUN_WINDOWS) { platforms << 'dotnet_windows' }
                    if (params.RUN_MACOS)   { platforms << 'dotnet_macos' }
                    if (params.RUN_IOS)     { platforms << 'dotnet_ios' }
                    if (params.RUN_ANDROID) { platforms << 'dotnet_android' }
                    if (platforms.isEmpty()) {
                        echo "No platforms selected — nothing to prebuild"
                    } else {
                        def parallelBuilds = [:]
                        for (p in platforms) {
                            // Copy to a local so each closure keeps its own platform
                            def platform = p
                            parallelBuilds[platform] = {
                                build job: 'prebuild-test-server',
                                parameters: [
                                    string(name: 'TS_PLATFORM', value: platform),
                                    string(name: 'CBL_VERSION', value: params.CBL_VERSION),
                                    string(name: 'CBL_BUILD', value: params.CBL_BUILD)
                                ],
                                wait: true,
                                propagate: true
                            }
                        }
                        parallel parallelBuilds
                    }
                }
            }
        }
        stage('Run Tests') {
            parallel {
                stage('Windows') {
                    when { beforeAgent true; expression { params.RUN_WINDOWS } }
                    agent { label WINDOWS_NODE }
                    options {
                        lock(WINDOWS_NODE)
                    }
                    environment {
                        TS_ARTIFACTS_DIR = 'dotnet_windows'
                    }
                    steps {
                        timeout(time: 120, unit: 'MINUTES') {
                            powershell "jenkins\\pipelines\\functional\\dotnet\\run_test.ps1 -Version '${env.FULL_CBL_VERSION}' -SgwVersion '${params.SGW_VERSION}' -DatasetVersion ${env.DATASET_VERSION} -TestFilter '${params.TS_TEST_FILTER}'"
                        }
                    }
                    post {
                        always {
                            // Publish pytest's JUnit XML so per-test failures (messages and
                            // tracebacks) are surfaced in Jenkins even if teardown fails.
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true
                            timeout(time: 5, unit: 'MINUTES') {
                                powershell 'jenkins\\pipelines\\functional\\dotnet\\teardown.ps1'
                            }
                            archiveArtifacts artifacts: 'tests/functional/dotnet_windows/**/*', fingerprint: true, allowEmptyArchive: true
                        }
                    }
                }
                stage('macOS') {
                    when { beforeAgent true; expression { params.RUN_MACOS } }
                    agent { label 'e2e&&macos-host' }
                    environment {
                        KEYCHAIN_PASSWORD = credentials("${env.NODE_NAME}-keychain-password")
                        TS_ARTIFACTS_DIR = 'dotnet_macos'
                    }
                    steps {
                        // Unlock keychain: the Mac Catalyst app is signed
                        sh 'security unlock-keychain -p ${KEYCHAIN_PASSWORD} ~/Library/Keychains/login.keychain-db'
                        // The label matches a shared pool and the test server binds
                        // fixed localhost ports, so serialize per node.
                        lock("${env.NODE_NAME}") {
                            timeout(time: 120, unit: 'MINUTES') {
                                sh "jenkins/pipelines/functional/dotnet/run_test.sh '${env.FULL_CBL_VERSION}' macos '${params.SGW_VERSION}' --dataset-version ${env.DATASET_VERSION} --test-filter '${params.TS_TEST_FILTER}'"
                            }
                        }
                    }
                    post {
                        always {
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true
                            timeout(time: 5, unit: 'MINUTES') {
                                sh 'jenkins/pipelines/functional/dotnet/teardown.sh'
                            }
                            archiveArtifacts artifacts: 'tests/functional/dotnet_macos/**/*', fingerprint: true, allowEmptyArchive: true
                        }
                    }
                }
                stage('iOS') {
                    when { beforeAgent true; expression { params.RUN_IOS } }
                    agent { label IOS_NODE }
                    options {
                        // Lock on the node name: every job sharing this iPhone locks on it.
                        lock(IOS_NODE)
                    }
                    environment {
                        KEYCHAIN_PASSWORD = credentials("${env.NODE_NAME}-keychain-password")
                        TS_ARTIFACTS_DIR = 'dotnet_ios'
                    }
                    steps {
                        sh 'security unlock-keychain -p ${KEYCHAIN_PASSWORD} ~/Library/Keychains/login.keychain-db'
                        timeout(time: 120, unit: 'MINUTES') {
                            sh "jenkins/pipelines/functional/dotnet/run_test.sh '${env.FULL_CBL_VERSION}' ios '${params.SGW_VERSION}' --dataset-version ${env.DATASET_VERSION} --test-filter '${params.TS_TEST_FILTER}'"
                        }
                    }
                    post {
                        always {
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true
                            timeout(time: 5, unit: 'MINUTES') {
                                sh 'jenkins/pipelines/functional/dotnet/teardown.sh'
                            }
                            archiveArtifacts artifacts: 'tests/functional/dotnet_ios/**/*', fingerprint: true, allowEmptyArchive: true
                        }
                    }
                }
                stage('Android') {
                    when { beforeAgent true; expression { params.RUN_ANDROID } }
                    agent { label ANDROID_NODE }
                    options {
                        lock(ANDROID_NODE)
                    }
                    environment {
                        // No ANDROID_SERIAL: the bridge passes `-s <location>` from the
                        // topology. SDK and JDK come from the node.
                        TS_ARTIFACTS_DIR = 'dotnet_android'
                    }
                    steps {
                        timeout(time: 120, unit: 'MINUTES') {
                            sh "jenkins/pipelines/functional/dotnet/run_test.sh '${env.FULL_CBL_VERSION}' android '${params.SGW_VERSION}' --dataset-version ${env.DATASET_VERSION} --test-filter '${params.TS_TEST_FILTER}'"
                        }
                    }
                    post {
                        always {
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true
                            timeout(time: 5, unit: 'MINUTES') {
                                sh 'jenkins/pipelines/functional/dotnet/teardown.sh'
                            }
                            archiveArtifacts artifacts: 'tests/functional/dotnet_android/**/*', fingerprint: true, allowEmptyArchive: true
                        }
                    }
                }
            }
        }
    }
    post {
        failure {
            mail bcc: '', body: "Project: <a href='${env.BUILD_URL}'>${env.JOB_NAME}</a> has failed!", cc: '', charset: 'UTF-8', from: 'jenkins@couchbase.com', mimeType: 'text/html', replyTo: 'no-reply@couchbase.com', subject: "${env.JOB_NAME} failed", to: MAIL_TO
        }
        fixed {
            mail bcc: '', body: "Project: <a href='${env.BUILD_URL}'>${env.JOB_NAME}</a> is back to normal (fixed).", cc: '', charset: 'UTF-8', from: 'jenkins@couchbase.com', mimeType: 'text/html', replyTo: 'no-reply@couchbase.com', subject: "${env.JOB_NAME} fixed", to: MAIL_TO
        }
    }
}
