// Functional tests for Couchbase Lite C on every C platform, U.S. lab.
// Merges the former dev_e2e/c and QE/c pipelines.
def US_IOS_NODE = 'mob-e2e-iphone-03'
def US_ANDROID_NODE = 'mob-e2e-android-01'

def failureMail(String target, String to) {
    mail bcc: '', body: "Project: <a href='${env.BUILD_URL}'>${env.JOB_NAME}</a> (${target}) has failed!", cc: '', charset: 'UTF-8', from: 'jenkins@couchbase.com', mimeType: 'text/html', replyTo: 'no-reply@couchbase.com', subject: "${env.JOB_NAME} - ${target} failed", to: to
}

def fixedMail(String target, String to) {
    mail bcc: '', body: "Project: <a href='${env.BUILD_URL}'>${env.JOB_NAME}</a> (${target}) is back to normal (fixed).", cc: '', charset: 'UTF-8', from: 'jenkins@couchbase.com', mimeType: 'text/html', replyTo: 'no-reply@couchbase.com', subject: "${env.JOB_NAME} - ${target} fixed", to: to
}

pipeline {
    agent none
    parameters {
        string(name: 'CBL_VERSION', defaultValue: '', description: 'Couchbase Lite version under test (required): 4, 4.1, 4.1.0 or 4.1.0-18')
        string(name: 'SGW_VERSION', defaultValue: '', description: 'Sync Gateway version: 4, 4.1, 4.1.0 or 4.1.0-18 (empty: the latest release)')
        string(name: 'ES_VERSION', defaultValue: '', description: 'Edge Server version: 1, 1.1, 1.1.1 or 1.1.1-5 (empty: the latest release)')
        choice(name: 'TS_DATASET_VERSION', choices: ['auto', '4.0', '3.2'], description: 'Test server dataset version (auto: 3.2 for CBL 3.x, else 4.0)')
        string(name: 'TS_TEST_FILTER', defaultValue: '', description: 'An optional pytest -k filter for running a subset of tests (disables result upload)')
        booleanParam(name: 'RUN_PREBUILD', defaultValue: true, description: 'Prebuild test servers (only for the checked platforms). Uncheck to skip prebuild entirely and reuse existing artifacts.')
        booleanParam(name: 'RUN_MACOS',   defaultValue: true, description: 'Run macOS tests')
        booleanParam(name: 'RUN_IOS',     defaultValue: true, description: 'Run iOS tests')
        booleanParam(name: 'RUN_ANDROID', defaultValue: true, description: 'Run Android tests')
        booleanParam(name: 'RUN_LINUX',   defaultValue: true, description: 'Run Linux tests')
        booleanParam(name: 'RUN_WINDOWS', defaultValue: true, description: 'Run Windows tests')
    }
    options {
        ansiColor('xterm')
        timestamps()
        timeout(time: 150, unit: 'MINUTES')
    }
    stages {
        stage('Init') {
            agent any
            steps {
                script {
                    def versions = load 'jenkins/pipelines/shared/productVersions.groovy'
                    versions.resolve('cbl', 'couchbase-lite-c', params)
                    env.FULL_CBL_VERSION = env.CBL_RESOLVED
                    // 'auto' picks the dataset from the CBL version: 3.x uses the 3.2 dataset, else 4.0
                    env.DATASET_VERSION = params.TS_DATASET_VERSION != 'auto' ? params.TS_DATASET_VERSION :
                        (env.CBL_RESOLVED.startsWith('3.') ? '3.2' : '4.0')
                    currentBuild.displayName = "C CBL:${env.FULL_CBL_VERSION} (#${currentBuild.number})"
                    currentBuild.description = "SGW: ${env.SGW_RESOLVED}, ES: ${env.ES_RESOLVED}, DS: ${env.DATASET_VERSION}"
                }
            }
        }
        stage('Prebuild Servers') {
            when { beforeAgent true; expression { params.RUN_PREBUILD } }
            steps {
                script {
                    def platforms = []
                    if (params.RUN_MACOS)   { platforms << 'c_macos' }
                    if (params.RUN_IOS)     { platforms << 'c_ios' }
                    if (params.RUN_ANDROID) { platforms << 'c_android' }
                    if (params.RUN_LINUX)   { platforms << 'c_linux_x86_64' }
                    if (params.RUN_WINDOWS) { platforms << 'c_windows' }
                    if (platforms.isEmpty()) {
                        echo "No platforms selected — nothing to prebuild"
                    } else {
                        def parallelBuilds = [:]
                        for (p in platforms) {
                            // Copy to a local so each closure keeps its own platform
                            def platform = p
                            parallelBuilds[platform] = {
                                build job: 'prebuild-test-server',
                                parameters: [
                                    string(name: 'TS_PLATFORM', value: platform),
                                    string(name: 'CBL_VERSION', value: env.CBL_PREBUILD_VERSION),
                                    string(name: 'CBL_BUILD', value: env.CBL_PREBUILD_BUILD)
                                ],
                                wait: true,
                                propagate: true
                            }
                        }
                        parallel parallelBuilds
                    }
                }
            }
        }
        stage('Run Tests') {
            parallel {
                stage('macOS') {
                    when { beforeAgent true; expression { params.RUN_MACOS } }
                    agent { label 'e2e&&macos-host' }
                    environment {
                        TS_ARTIFACTS_DIR = 'c_macos'
                    }
                    steps {
                        // The label matches a shared pool and the test server binds
                        // fixed localhost ports, so serialize per node.
                        lock("${env.NODE_NAME}") {
                            timeout(time: 120, unit: 'MINUTES') {
                                sh "jenkins/pipelines/functional/c/run_test.sh '${env.FULL_CBL_VERSION}' macos '${env.SGW_RESOLVED}' --es-version '${env.ES_RESOLVED}' --dataset-version ${env.DATASET_VERSION} --test-filter '${params.TS_TEST_FILTER}'"
                            }
                        }
                    }
                    post {
                        always {
                            // Publish pytest's JUnit XML so per-test failures (messages and
                            // tracebacks) are surfaced in Jenkins even if teardown fails.
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true
                            timeout(time: 5, unit: 'MINUTES') {
                                sh 'jenkins/pipelines/functional/c/teardown.sh'
                            }
                            archiveArtifacts artifacts: 'tests/functional/c_macos/**/*', fingerprint: true, allowEmptyArchive: true
                        }
                        failure { failureMail('C macOS', 'sanjivani.patra@couchbase.com') }
                        fixed { fixedMail('C macOS', 'sanjivani.patra@couchbase.com') }
                    }
                }
                stage('iOS') {
                    when { beforeAgent true; expression { params.RUN_IOS } }
                    agent { label US_IOS_NODE }
                    options {
                        // Lock on the node name: every job sharing this iPhone locks on it.
                        lock(US_IOS_NODE)
                    }
                    environment {
                        KEYCHAIN_PASSWORD = credentials("${env.NODE_NAME}-keychain-password")
                        TS_ARTIFACTS_DIR = 'c_ios'
                    }
                    steps {
                        sh 'security unlock-keychain -p ${KEYCHAIN_PASSWORD} ~/Library/Keychains/login.keychain-db'
                        timeout(time: 120, unit: 'MINUTES') {
                            sh "jenkins/pipelines/functional/c/run_test.sh '${env.FULL_CBL_VERSION}' ios '${env.SGW_RESOLVED}' --es-version '${env.ES_RESOLVED}' --dataset-version ${env.DATASET_VERSION} --test-filter '${params.TS_TEST_FILTER}'"
                        }
                    }
                    post {
                        always {
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true
                            timeout(time: 5, unit: 'MINUTES') {
                                sh 'jenkins/pipelines/functional/c/teardown.sh'
                            }
                            archiveArtifacts artifacts: 'tests/functional/c_ios/**/*', fingerprint: true, allowEmptyArchive: true
                        }
                        failure { failureMail('C iOS', 'barkha.goyal@couchbase.com') }
                        fixed { fixedMail('C iOS', 'barkha.goyal@couchbase.com') }
                    }
                }
                stage('Android') {
                    when { beforeAgent true; expression { params.RUN_ANDROID } }
                    agent { label US_ANDROID_NODE }
                    options {
                        lock(US_ANDROID_NODE)
                    }
                    environment {
                        // No ANDROID_SERIAL: the bridge passes `-s <location>` from the
                        // topology. SDK and JDK come from the node.
                        TS_ARTIFACTS_DIR = 'c_android'
                    }
                    steps {
                        timeout(time: 120, unit: 'MINUTES') {
                            sh "jenkins/pipelines/functional/c/run_test.sh '${env.FULL_CBL_VERSION}' android '${env.SGW_RESOLVED}' --es-version '${env.ES_RESOLVED}' --dataset-version ${env.DATASET_VERSION} --test-filter '${params.TS_TEST_FILTER}'"
                        }
                    }
                    post {
                        always {
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true
                            timeout(time: 5, unit: 'MINUTES') {
                                sh 'jenkins/pipelines/functional/c/teardown.sh'
                            }
                            archiveArtifacts artifacts: 'tests/functional/c_android/**/*', fingerprint: true, allowEmptyArchive: true
                        }
                        failure { failureMail('C Android', 'barkha.goyal@couchbase.com') }
                        fixed { fixedMail('C Android', 'barkha.goyal@couchbase.com') }
                    }
                }
                stage('Linux') {
                    when { beforeAgent true; expression { params.RUN_LINUX } }
                    agent { label 'e2e&&linux-host' }
                    environment {
                        TS_ARTIFACTS_DIR = 'c_linux'
                    }
                    steps {
                        lock("${env.NODE_NAME}") {
                            timeout(time: 120, unit: 'MINUTES') {
                                sh "jenkins/pipelines/functional/c/run_test.sh '${env.FULL_CBL_VERSION}' linux_x86_64 '${env.SGW_RESOLVED}' --es-version '${env.ES_RESOLVED}' --dataset-version ${env.DATASET_VERSION} --test-filter '${params.TS_TEST_FILTER}'"
                            }
                        }
                    }
                    post {
                        always {
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true
                            timeout(time: 5, unit: 'MINUTES') {
                                sh 'jenkins/pipelines/functional/c/teardown.sh'
                            }
                            archiveArtifacts artifacts: 'tests/functional/c_linux/**/*', fingerprint: true, allowEmptyArchive: true
                        }
                        failure { failureMail('C Linux', 'sanjivani.patra@couchbase.com') }
                        fixed { fixedMail('C Linux', 'sanjivani.patra@couchbase.com') }
                    }
                }
                stage('Windows') {
                    when { beforeAgent true; expression { params.RUN_WINDOWS } }
                    agent { label 'e2e&&windows-host' }
                    environment {
                        TS_ARTIFACTS_DIR = 'c_windows'
                    }
                    steps {
                        lock("${env.NODE_NAME}") {
                            timeout(time: 120, unit: 'MINUTES') {
                                pwsh "jenkins\\pipelines\\functional\\c\\run_test.ps1 -Version '${env.FULL_CBL_VERSION}' -SgwVersion '${env.SGW_RESOLVED}' -EsVersion '${env.ES_RESOLVED}' -DatasetVersion ${env.DATASET_VERSION} -TestFilter '${params.TS_TEST_FILTER}'"
                            }
                        }
                    }
                    post {
                        always {
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true
                            timeout(time: 5, unit: 'MINUTES') {
                                pwsh 'jenkins\\pipelines\\functional\\c\\teardown.ps1'
                            }
                            archiveArtifacts artifacts: 'tests/functional/c_windows/**/*', fingerprint: true, allowEmptyArchive: true
                        }
                        failure { failureMail('C Windows', 'barkha.goyal@couchbase.com') }
                        fixed { fixedMail('C Windows', 'barkha.goyal@couchbase.com') }
                    }
                }
            }
        }
    }
    post {
        failure {
            mail bcc: '', body: "Project: <a href='${env.BUILD_URL}'>${env.JOB_NAME}</a> has failed!", cc: '', charset: 'UTF-8', from: 'jenkins@couchbase.com', mimeType: 'text/html', replyTo: 'no-reply@couchbase.com', subject: "${env.JOB_NAME} failed", to: "pasin@couchbase.com"
        }
    }
}
