pipeline {
    agent none
    // See jenkins/pipelines/shared/productVersions.groovy for how the versions resolve.
    parameters {
        string(name: 'SGW_VERSION', defaultValue: '', description: 'Sync Gateway version under test (required): 4, 4.1, 4.1.0 or 4.1.0-18')
        string(name: 'CBL_VERSION', defaultValue: '', description: 'Couchbase Lite C version: 4, 4.1, 4.1.0 or 4.1.0-18 (empty: the latest release)')
        string(name: 'ES_VERSION', defaultValue: '', description: 'Edge Server version: 1, 1.1, 1.1.1 or 1.1.1-5 (empty: the latest release)')
        choice(name: 'TS_DATASET_VERSION', choices: ['4.0', '3.2'], description: 'Test server dataset version. CBL 3.x needs 3.2; CBL 4.x can use either.')
        string(name: 'TS_TEST_FILTER', defaultValue: '', description: 'An optional pytest -k filter for running a subset of tests (disables result upload)')
        booleanParam(name: 'RUN_PREBUILD', defaultValue: true, description: 'Prebuild the c_macos test server. Uncheck to reuse existing artifacts.')
    }
    options {
        ansiColor('xterm')
        timestamps()
    }
    stages {
        stage('Init') {
            agent any
            steps {
                script {
                    def versions = load 'jenkins/pipelines/shared/productVersions.groovy'
                    versions.resolve('sgw', 'couchbase-lite-c', params)
                    env.TS_TEST_FILTER = params.TS_TEST_FILTER ?: ''
                    env.TS_DATASET_VERSION = params.TS_DATASET_VERSION
                    currentBuild.displayName = "SGW:${env.SGW_RESOLVED} CBL:${env.CBL_RESOLVED} (#${currentBuild.number})"
                    currentBuild.description = "ES: ${env.ES_RESOLVED}, DS: ${env.TS_DATASET_VERSION}"
                }
            }
        }
        stage('Prebuild Servers') {
            when { beforeAgent true; expression { params.RUN_PREBUILD } }
            steps {
                build job: 'prebuild-test-server',
                parameters: [
                    string(name: 'TS_PLATFORM', value: 'c_macos'),
                    string(name: 'CBL_VERSION', value: env.CBL_PREBUILD_VERSION),
                    string(name: 'CBL_BUILD', value: env.CBL_PREBUILD_BUILD),
                ],
                wait: true,
                propagate: true
            }
        }
        stage('Run Test') {
            agent { label 'mac-mini-new' }
            environment {
                KEYCHAIN_PASSWORD = credentials('mac-mini-new-keychain-password')
                PATH = "/opt/homebrew/opt/python@3.10/bin:/opt/homebrew/bin:/usr/local/bin:${env.PATH}"
                TS_ARTIFACTS_DIR = 'sgw'
                // pytest's graceful stop budget (seconds), applied by the timeout_fixture plugin via
                // --session-timeout. Kept comfortably below the stage timeout below so pytest stops itself
                // gracefully -- with a runway to finish junit/greenboard/sgcollect/cbcollect -- before Jenkins' hard
                // SIGTERM. The sgcollect and cbcollect session fixtures tear down one after the other, not in parallel,
                // so the runway must cover both: up to ~8.5m of sgcollect polling plus up to 21m for cbcollect (the
                // 1260s _COLLECT_LOGS_TIMEOUT in couchbaseserver.py), plus archive downloads.
                CBL_PYTEST_SESSION_TIMEOUT = '9000'
            }
            steps {
                // Unlock keychain:
                sh "security unlock-keychain -p '${KEYCHAIN_PASSWORD}' ~/Library/Keychains/login.keychain-db"
                timeout(time: 210, unit: 'MINUTES') {
                    sh "jenkins/pipelines/functional/sgw/test.sh '${env.CBL_RESOLVED}' '${env.SGW_RESOLVED}' --es-version '${env.ES_RESOLVED}' --dataset-version '${env.TS_DATASET_VERSION}' --test-filter '${env.TS_TEST_FILTER}'"
                }
            }
            post {
                always {
                    junit testResults: 'tests/functional/junit_result.xml', allowEmptyResults: true

                    timeout(time: 5, unit: 'MINUTES') {
                        sh "jenkins/pipelines/functional/sgw/teardown.sh"
                    }
                    // Archived after teardown because teardown's move_artifacts
                    // is what populates tests/functional/sgw/.
                    archiveArtifacts artifacts: 'tests/functional/sgw/**/*', fingerprint: true, allowEmptyArchive: true
                }
            }
        }
    }
    post {
        failure {
            mail bcc: '', body: "Project: <a href='${env.BUILD_URL}'>${env.JOB_NAME}</a> has failed!", cc: '', charset: 'UTF-8', from: 'jenkins@couchbase.com', mimeType: 'text/html', replyTo: 'no-reply@couchbase.com', subject: "${env.JOB_NAME} failed", to: "vipul.bhardwaj@couchbase.com";
        }
        fixed {
            mail bcc: '', body: "Project: <a href='${env.BUILD_URL}'>${env.JOB_NAME}</a> is back to normal (fixed).", cc: '', charset: 'UTF-8', from: 'jenkins@couchbase.com', mimeType: 'text/html', replyTo: 'no-reply@couchbase.com', subject: "${env.JOB_NAME} fixed", to: "vipul.bhardwaj@couchbase.com";
        }
    }
}