pipeline {
    agent none
    parameters {
        choice(name: 'CBL_EDITION', choices: ['enterprise', 'community'], description: 'Couchbase Lite Edition')
        string(name: 'CBL_VERSION', defaultValue: '3.2.0', description: 'Couchbase Lite Version')
        string(name: 'CBL_BUILD', defaultValue: '', description: 'Couchbase Lite Build Number')
        string(name: 'SGW_VERSION', defaultValue: '', description: "The version of Sync Gateway to download")
        string(name: 'TS_DATASET_VERSION', defaultValue: '4.0', description: 'The version of the dataset to use on the test servers')
        string(name: 'TS_TEST_FILTER', defaultValue: '', description: 'An optional filter for running a subset of tests')
        booleanParam(name: 'RUN_PREBUILD', defaultValue: true, description: 'Prebuild test servers (only for the checked platforms). Uncheck to skip prebuild entirely and reuse existing artifacts.')
        booleanParam(name: 'RUN_MACOS',   defaultValue: true, description: 'Run macOS tests')
        booleanParam(name: 'RUN_IOS',     defaultValue: true, description: 'Run iOS tests')
        booleanParam(name: 'RUN_ANDROID', defaultValue: true, description: 'Run Android tests')
        booleanParam(name: 'RUN_LINUX',   defaultValue: true, description: 'Run Linux tests')
        booleanParam(name: 'RUN_WINDOWS', defaultValue: true, description: 'Run Windows tests')
    }
    options {
        ansiColor('xterm')
        timestamps()
        timeout(time: 90, unit: 'MINUTES')
    }
    stages {
        stage('Init') {
            steps {
                script {
                    if (params.CBL_VERSION == '') { error "CBL_VERSION is required" }
                    if (params.CBL_BUILD == '') { error "CBL_BUILD is required" }
                    if (params.SGW_VERSION == '') { error "SGW_VERSION is required" }
                    currentBuild.displayName = "${params.CBL_VERSION}-${params.CBL_BUILD}-${CBL_EDITION} (#${currentBuild.number})"
                    currentBuild.description = "SGW: ${params.SGW_VERSION}"
                }
            }
        }
        stage('Prebuild Servers') {
            when { beforeAgent true; expression { params.RUN_PREBUILD } }
            steps {
                script {
                    def platforms = []
                    if (params.RUN_WINDOWS) { platforms << 'c_windows' }
                    if (params.RUN_IOS)     { platforms << 'c_ios' }
                    if (params.RUN_ANDROID) { platforms << 'c_android' }
                    if (params.RUN_MACOS)   { platforms << 'c_macos' }
                    if (params.RUN_LINUX)   { platforms << 'c_linux_x86_64' }
                    if (platforms.isEmpty()) {
                        echo "No platforms selected — nothing to prebuild"
                    } else {
                        def parallelBuilds = [:]
                        for(p in platforms) {
                            // Groovy stupidness.  Need to set a local variable here
                            // to avoid late binding (all jobs use dotnet_macos).
                            def platform = p
                            parallelBuilds[platform] = {
                                build job: 'prebuild-test-server',
                                parameters: [
                                    string(name: 'TS_PLATFORM', value: platform),
                                    string(name: 'CBL_VERSION', value: params.CBL_VERSION),
                                    string(name: 'CBL_BUILD', value: params.CBL_BUILD)
                                ],
                                wait: true,
                                propagate: true
                            }
                        }
                        parallel parallelBuilds
                    }
                }
            }
        }
        stage('Run Tests') {
            parallel {
                stage('macOS') {
                    when { beforeAgent true; expression { params.RUN_MACOS } }
                    agent { label 'e2e&&macos-host' }
                    environment {
                        TS_ARTIFACTS_DIR = 'macos'
                    }
                    steps {
                        echo "Run macOS Test"
                        lock("${env.NODE_NAME}") {
                            timeout(time: 60, unit: 'MINUTES') {
                                sh "jenkins/pipelines/dev_e2e/c/run_test.sh ${params.CBL_VERSION}-${params.CBL_BUILD} macos '${params.SGW_VERSION}' --dataset-version ${params.TS_DATASET_VERSION} --test-filter '${params.TS_TEST_FILTER}'"
                            }
                        }
                    }
                    post {
                        always {
                            // Publish pytest's JUnit XML so per-test failures (messages and
                            // tracebacks) are surfaced in Jenkins even if teardown fails.
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true

                            echo "Teardown macOS Test"
                            timeout(time: 5, unit: 'MINUTES') {
                                sh 'jenkins/pipelines/dev_e2e/c/teardown.sh'
                            }
                            archiveArtifacts artifacts: 'tests/dev_e2e/macOS/**', fingerprint: true, allowEmptyArchive: true
                        }
                    }
                }
                stage('iOS') {
                    when { beforeAgent true; expression { params.RUN_IOS } }
                    agent { label 'mob-e2e-iphone-03' }
                    environment {
                        KEYCHAIN_PASSWORD = credentials("${env.NODE_NAME}-keychain-password")
                        TS_ARTIFACTS_DIR = 'ios'
                    }
                    steps {
                        // Unlock keychain:
                        sh 'security unlock-keychain -p ${KEYCHAIN_PASSWORD} ~/Library/Keychains/login.keychain-db'
                        echo "Run iOS Test"
                        lock('mob-e2e-iphone-03') {
                            timeout(time: 60, unit: 'MINUTES') {
                                sh "jenkins/pipelines/dev_e2e/c/run_test.sh ${params.CBL_VERSION}-${params.CBL_BUILD} ios '${params.SGW_VERSION}' --dataset-version ${params.TS_DATASET_VERSION} --test-filter '${params.TS_TEST_FILTER}'"
                            }
                        }
                    }
                    post { 
                        always { 
                            // Publish pytest's JUnit XML so per-test failures (messages and
                            // tracebacks) are surfaced in Jenkins even if teardown fails.
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true

                            echo "Teardown iOS Test"
                            timeout(time: 5, unit: 'MINUTES') {
                                sh 'jenkins/pipelines/dev_e2e/c/teardown.sh'
                            } 
                            archiveArtifacts artifacts: 'tests/dev_e2e/ios/**', fingerprint: true, allowEmptyArchive: true
                        }
                    }
                }
                stage('Android') {
                    when { beforeAgent true; expression { params.RUN_ANDROID } }
                    agent { label 'mob-e2e-android-01' }
                    environment {
                        TS_ARTIFACTS_DIR = 'android'
                    }
                    steps {
                        echo "Run Android Test"
                        lock('mob-e2e-android-01') {
                            timeout(time: 60, unit: 'MINUTES') {
                                sh "jenkins/pipelines/dev_e2e/c/run_test.sh ${params.CBL_VERSION}-${params.CBL_BUILD} android '${params.SGW_VERSION}' --dataset-version ${params.TS_DATASET_VERSION} --test-filter '${params.TS_TEST_FILTER}'"
                            }
                        }
                    }
                    post {
                        always {
                            // Publish pytest's JUnit XML so per-test failures (messages and
                            // tracebacks) are surfaced in Jenkins even if teardown fails.
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true

                            echo "Teardown Android Test"
                            timeout(time: 5, unit: 'MINUTES') {
                                sh 'jenkins/pipelines/dev_e2e/c/teardown.sh'
                            }
                            archiveArtifacts artifacts: 'tests/dev_e2e/android/**', fingerprint: true, allowEmptyArchive: true
                        }
                    }
                }
                stage('linux') {
                    when { beforeAgent true; expression { params.RUN_LINUX } }
                    agent { label 'e2e&&linux-host' }
                    environment {
                        TS_ARTIFACTS_DIR = 'linux_x86_64'
                    }
                    steps {
                        echo "Run linux Test"
                        lock("${env.NODE_NAME}") {
                            timeout(time: 60, unit: 'MINUTES') {
                                sh "jenkins/pipelines/dev_e2e/c/run_test.sh ${params.CBL_VERSION}-${params.CBL_BUILD} linux_x86_64 '${params.SGW_VERSION}' --dataset-version ${params.TS_DATASET_VERSION} --test-filter '${params.TS_TEST_FILTER}'"
                            }
                        }
                    }
                    post {
                        always {
                            // Publish pytest's JUnit XML so per-test failures (messages and
                            // tracebacks) are surfaced in Jenkins even if teardown fails.
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true

                            echo "Teardown linux Test"
                            timeout(time: 5, unit: 'MINUTES') {
                                sh 'jenkins/pipelines/dev_e2e/c/teardown.sh'
                            }
                            archiveArtifacts artifacts: 'tests/dev_e2e/linux_x86_64/**', fingerprint: true, allowEmptyArchive: true
                        }
                    }
                }
                stage('windows') {
                    when { beforeAgent true; expression { params.RUN_WINDOWS } }
                    agent { label 'e2e&&windows-host' }
                    steps {
                        lock("${env.NODE_NAME}") {
                            timeout(time: 60, unit: 'MINUTES') {
                                pwsh "jenkins\\pipelines\\dev_e2e\\c\\run_test.ps1 -Version ${params.CBL_VERSION}-${params.CBL_BUILD} -SgwVersion ${params.SGW_VERSION} -DatasetVersion ${params.TS_DATASET_VERSION} -TestFilter '${params.TS_TEST_FILTER}'"
                            }
                        }
                    }
                    post {
                        always {
                            // Publish pytest's JUnit XML so per-test failures (messages and
                            // tracebacks) are surfaced in Jenkins even if teardown fails.
                            junit testResults: '**/junit_result.xml', allowEmptyResults: true

                            echo "Teardown Windows Test"
                            timeout(time: 5, unit: 'MINUTES') {
                                pwsh 'jenkins\\pipelines\\dev_e2e\\c\\teardown.ps1'
                            }
                            archiveArtifacts artifacts: 'tests\\dev_e2e\\windows\\**', fingerprint: true, allowEmptyArchive: true
                        }
                    }
                }
            }
        }
    }
    post {
        failure {
            mail bcc: '', body: "Project: <a href='${env.BUILD_URL}'>${env.JOB_NAME}</a> has failed!", cc: '', charset: 'UTF-8', from: 'jenkins@couchbase.com', mimeType: 'text/html', replyTo: 'no-reply@couchbase.com', subject: "${env.JOB_NAME} failed", to: "pasin@couchbase.com";
        }
    }
}