http:
  serversTransports:
    sg-upstream:
      insecureSkipVerify: true
      maxIdleConnsPerHost: 1000
      forwardingTimeouts:
        # A node that is gone black-holes the connection, and the pool waits this long on it
        # before retrying the next node, so keep it just long enough for a healthy dial.
        dialTimeout: 5s
        responseHeaderTimeout: 360s
        idleConnTimeout: 360s

  middlewares:
    limit-body:
      buffering:
        maxRequestBodyBytes: 20971520
    # attempts is rewritten to the node count by setup_load_balancers.py
    retry-next-node:
      retry:
        attempts: 2
        initialInterval: 100ms
    # No client IP can match this range, so every request routed here is rejected.
    reject-unknown-pin:
      ipAllowList:
        sourceRange:
          - "255.255.255.255/32"
        rejectStatusCode: 500