{
  "bootstrap": {
    "server": "rosmar:/?mode=memory",
    "server_tls_skip_verify": true,
    "use_tls_server": false,
    "username": "Administrator",
    "password": "password",
    "config_update_frequency": "200ms"
  },
  "logging": {
    "console": {
      "enabled": true,
      "log_level": "debug",
      "log_keys": ["*"]
    }
  },
  "api": {
    "admin_interface_authentication": false,
    "metrics_interface_authentication": false,
    "cors": {
      "origin": ["http://localhost:5173"],
      "login_origin": ["http://localhost:5173"],
      "headers": ["Authorization"]
    }
  },
  "unsupported": {
    "rosmar_bucket_management": true
  }
}
