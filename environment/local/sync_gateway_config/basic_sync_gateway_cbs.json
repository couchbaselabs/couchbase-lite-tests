{
  "bootstrap": {
    "server": "couchbase://localhost",
    "server_tls_skip_verify": true,
    "use_tls_server": false,
    "username": "Administrator",
    "password": "password"
  },
  "api": {
    "cors": {
      "origin": ["http://localhost:5173"],
      "login_origin": ["http://localhost:5173"],
      "headers": ["Authorization"]
    }
  },
  "logging": {
    "console": {
      "enabled": true,
      "log_level": "info",
      "log_keys": ["*"]
    }
  }
}
