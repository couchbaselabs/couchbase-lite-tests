{
  "name": "@couchbase/test-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/couchbaselabs/couchbase-lite-tests.git"
  },
  "displayName": "Couchbase Lite Test Server for JavaScript",
  "type": "module",
  "version": "1.2.2",
  "scripts": {
    "dev": "vite --force",
    "test": "vitest --run",
    "test:browser": "vitest --run --browser",
    "test:watch": "vitest --watch",
    "typecheck": "tsc",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "precommit": "npm install --no-audit --no-fund --loglevel=error && npm run format && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@couchbase/lite-js": "^1.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@eslint/js": "^9.38.0",
    "@types/node": "^22.17.0",
    "@vitest/browser": "^3.2.4",
    "ajv": "^8.17.1",
    "fake-indexeddb": "^6.2.4",
    "playwright": "^1.54.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
